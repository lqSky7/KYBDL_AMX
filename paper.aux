\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cross-scheme AMX feasibility: kernel speedup $S = t_{\text  {NEON}}/t_{\text  {AMX}}$ on Apple M3 (log scale). Kernels with $S > 1$ benefit from AMX acceleration; those with $S < 1$ are faster on NEON. The measured $S$ values span over three orders of magnitude, from $1.69$ (MAYO-5) to $0.00064$ (HQC dense).}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:crossscheme}{{6}{8}{Cross-scheme AMX feasibility: kernel speedup $S = t_{\text {NEON}}/t_{\text {AMX}}$ on Apple M3 (log scale). Kernels with $S > 1$ benefit from AMX acceleration; those with $S < 1$ are faster on NEON. The measured $S$ values span over three orders of magnitude, from $1.69$ (MAYO-5) to $0.00064$ (HQC dense)}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces AMX suitability heuristic applied to six post-quantum schemes. AMX kernel speedup ($S > 1$) is observed only when all three conditions are satisfied: dense MAC workload, small modulus, and no competing NEON instruction.}}{8}{table.caption.11}\protected@file@percent }
\newlabel{tab:criterion}{{5}{8}{AMX suitability heuristic applied to six post-quantum schemes. AMX kernel speedup ($S > 1$) is observed only when all three conditions are satisfied: dense MAC workload, small modulus, and no competing NEON instruction}{table.caption.11}{}}
